# ============================================================
#  CodeSync Platform — Environment Variables (TEMPLATE)
#  Copy this file to .env and fill in your actual values.
#  DO NOT commit the .env file to version control.
# ============================================================

# --- PostgreSQL (shared by most services) --------------------
DB_URL=jdbc:postgresql://localhost:5432/projectdb
DB_URL_AUTH=jdbc:postgresql://localhost:5432/codecollab
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password

# --- JWT -----------------------------------------------------
JWT_SECRET=your_jwt_secret_base64_encoded

# --- Google OAuth2 -------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# --- GitHub OAuth2 -------------------------------------------
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# --- SMTP (Gmail App Password) -------------------------------
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password

# --- Redis ---------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Razorpay (Test Mode) ------------------------------------
RAZORPAY_KEY_ID=rzp_test_REPLACE_ME
RAZORPAY_KEY_SECRET=REPLACE_ME_WITH_SECRET
